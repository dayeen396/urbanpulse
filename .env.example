POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://urbanpulse:replace-with-a-local-password@postgres:5432/urbanpulse
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-for-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-for-refresh
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:3000/api/v1
ML_SERVICE_URL=http://ml:8000
MAX_AUDIO_SIZE_BYTES=10000000
DELETE_AUDIO_AFTER_PROCESSING=false
NOISE_MODEL_METHOD=classical
# Supported noise models: classical (SVM), random_forest, neural (ResNet-18)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
